# Supabase configuration — copy this file to `.env` and fill in your values.
# Find both under Supabase Dashboard → Project Settings → API.
#
# Use ONLY the public "anon" key here. Never put the service_role key in a
# client-side app — it bypasses Row Level Security.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ------------------------------------------------------------------
# Whop subscription gate — SERVER-SIDE ONLY. Set these in the Vercel project
# (Settings → Environment Variables), NOT in a client .env. They are read by the
# serverless functions in api/whop/* via process.env and never reach the browser.
#
#   WHOP_API_KEY   Your Whop API key (Whop dashboard → Settings → Developer),
#                  with read access to memberships.
#   WHOP_PLAN_ID   The paid plan id (also enforced so only this plan unlocks).
#   WHOP_API_BASE  Optional base override (default https://api.whop.com).
#
# Validation uses Whop v2: POST /api/v2/memberships/{licenseKey}/validate_license
# (license key in the path, success = HTTP 201).
# ------------------------------------------------------------------

WHOP_API_KEY=YOUR-WHOP-API-KEY
WHOP_PLAN_ID=plan_NwB6iHkwaNvEM
# WHOP_API_BASE=https://api.whop.com
